{
  "name": "tiger-music-tag-editor-desktop",
  "version": "0.1.0",
  "description": "Tiger Music Tag Editor desktop shell (Electron + Vue 3 + TypeScript)",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "prepare:resources": "node scripts/prepare-fpcalc.mjs",
    "build:unpack": "npm run build && npm run prepare:resources && electron-builder --dir",
    "build:win": "npm run build && npm run prepare:resources && electron-builder --win"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
